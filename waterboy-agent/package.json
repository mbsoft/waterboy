{
  "name": "waterboy-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Waterboy: a local iMessage <-> Claude assistant for macOS, built on the Claude Agent SDK",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/index.ts",
    "repl": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/repl.ts",
    "doctor": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/doctor.ts",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --log-level=warning --outfile=dist/index.mjs",
    "test": "node --import tsx --test --no-warnings test/*.test.ts",
    "install-service": "bash scripts/install-launchd.sh",
    "uninstall-service": "bash scripts/uninstall-launchd.sh",
    "start:dry": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/index.ts --dry-run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.280",
    "croner": "^10.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0"
  }
}
